# ==============================================================================
# NOPROXY ATTENDANCE MANAGEMENT SAAS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# For production deployment (e.g. Vercel), add these variables in your Project Settings.

# ------------------------------------------------------------------------------
# 1. APPLICATION & BASE URL (REQUIRED)
# ------------------------------------------------------------------------------
# Public URL where the application is hosted
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTH (REQUIRED FOR PRODUCTION DEPLOYMENT)
# ------------------------------------------------------------------------------
# Obtain from: https://supabase.com/dashboard/project/<project-ref>/settings/api
# Public Supabase URL (Client-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase Anonymous Key (Client-safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Secret (CRITICAL: SERVER-ONLY, NEVER EXPOSE IN CLIENT CODE)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 3. DYNAMIC QR CRYPTOGRAPHIC HMAC SIGNING SECRET (REQUIRED)
# ------------------------------------------------------------------------------
# 64-character random hex string used to sign sliding HMAC-SHA256 dynamic QR challenges
# Generate via: openssl rand -hex 32
QR_SIGNING_SECRET=d3b07384d113edec49eaa6238ad5ff00cf3b194cf346f007b8b29cfc0b3c6767

# Sliding dynamic QR expiration in seconds (default: 20 seconds)
NEXT_PUBLIC_QR_EXPIRY_SECONDS=20

# ------------------------------------------------------------------------------
# 4. INITIAL SUPER ADMIN PROVISIONING (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Used by `npm run provision:admin` to seed or verify the institutional Super Admin
INITIAL_ADMIN_EMAIL=admin@noproxy.edu
INITIAL_ADMIN_PASSWORD=Admin@NoProxy2026!

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH 2.0 INTEGRATION (OPTIONAL)
# ------------------------------------------------------------------------------
# Obtain from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<supabase-project-id>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 6. DEMO / MOCK DATABASE MODE (DEVELOPMENT ONLY)
# ------------------------------------------------------------------------------
# Set to 'true' to run locally with pre-seeded demo institute, trainers, and batches.
# Set to 'false' in production so all operations strictly hit Supabase PostgreSQL.
NEXT_PUBLIC_DEMO_MODE=true
