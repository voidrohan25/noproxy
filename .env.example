# ==============================================================================
# NOPROXY ENVIRONMENT CONFIGURATION
# ==============================================================================

# NEXT.JS APPLICATION URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SUPABASE PUBLIC CREDENTIALS (Client-side safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SUPABASE SERVICE ROLE KEY (Server-only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# DYNAMIC QR CHALLENGE HMAC SECRET (Server-only)
QR_SIGNING_SECRET=replace_with_a_secure_random_64_character_hex_key_for_hmac

# DEFAULT QR EXPIRY DURATION (in seconds, typically 15 to 30)
NEXT_PUBLIC_QR_EXPIRY_SECONDS=20

# DEMO / MOCK DATA MODE
# Set to 'true' to allow standalone testing with pre-seeded demo database in development
NEXT_PUBLIC_DEMO_MODE=true
